<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF3E0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- CABEÇALHO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="95dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Nome -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SABOR&#10;&amp; BRASA"
                android:textColor="#8B2E16"
                android:textSize="27sp"
                android:textStyle="bold" />

            <!-- Logo -->
            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="90dp"
                android:layout_height="85dp"
                android:contentDescription="Logo do restaurante"
                android:scaleType="centerInside"
                android:src="@drawable/saborxbrasa"/>
        </LinearLayout>

        <!-- TÍTULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Calculadora de Conta"
            android:textColor="#5D4037"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="15dp"
            android:gravity="center"
            android:text="Calcule sua conta de forma rápida e fácil"
            android:textColor="#795548"
            android:textSize="13sp" />

        <!-- CONSUMO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consumo total (R$)"
            android:textColor="#5D4037"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtConsumo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="3dp"
            android:hint="Digite o valor do consumo"
            android:inputType="numberDecimal"
            android:padding="10dp" />

        <!-- COUVERT -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Couvert artístico (R$)"
            android:textColor="#5D4037"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtCouvert"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="3dp"
            android:hint="Digite o valor do couvert"
            android:inputType="numberDecimal"
            android:padding="10dp" />

        <!-- PESSOAS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Dividir conta por:"
            android:textColor="#5D4037"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtPessoas"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="3dp"
            android:hint="Quantidade de pessoas"
            android:inputType="number"
            android:padding="10dp" />

        <!-- BOTÃO -->
        <Button
            android:id="@+id/btnCalcular"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#8B2E16"
            android:text="CALCULAR CONTA FINAL"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- RESUMO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="RESUMO DA CONTA"
            android:textColor="#8B2E16"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- TAXA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Taxa de serviço (10%)"
                android:textColor="#5D4037"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtTaxa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:textColor="#795548"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- TOTAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Conta total"
                android:textColor="#5D4037"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:textColor="#8B2E16"
                android:textSize="19sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- POR PESSOA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Valor por pessoa"
                android:textColor="#5D4037"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPorPessoa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:textColor="#8B2E16"
                android:textSize="19sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>